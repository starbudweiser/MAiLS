# Instance Dovecot de test pour MAiLS : sans root, localhost seulement, sans TLS, données jetables.
# @ROOT@ est remplacé par start_dovecot.sh.
dovecot_config_version = 2.4.5
dovecot_storage_version = 2.4.5

base_dir = @ROOT@/run
state_dir = @ROOT@/state
log_path = @ROOT@/dovecot.log
info_log_path = @ROOT@/dovecot.log
default_internal_user = @USER@
default_internal_group = @GROUP@
default_login_user = @USER@
# macOS refuse tout setrlimit(RLIMIT_DATA) fini : on passe RLIM_INFINITY (2^63-1) pour que Dovecot n'échoue pas.
default_vsz_limit = 9223372036854775807

listen = 127.0.0.1

protocols {
  imap = yes
}

ssl = no
auth_allow_cleartext = yes
auth_mechanisms = plain login

mail_driver = maildir
mail_path = @ROOT@/Maildir
mail_home = @ROOT@/home

service imap-login {
  # Sans root : pas de chroot.
  chroot =
  inet_listener imap {
    port = @PORT@
  }
  inet_listener imaps {
    port = 0
  }
}

passdb static {
  password = test
}

userdb static {
  fields {
    uid = @UID@
    gid = @GID@
    home = @ROOT@/home
  }
}

namespace inbox {
  inbox = yes
  separator = /
  mailbox Drafts {
    special_use = \Drafts
  }
  mailbox Sent {
    special_use = \Sent
  }
  mailbox Trash {
    special_use = \Trash
  }
  mailbox Archive {
    special_use = \Archive
  }
}
